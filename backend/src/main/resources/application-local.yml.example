# ============================================================
# 本地私密配置模板：
#   1. 复制本文件为 application-local.yml（同目录）
#   2. 填入真实值后即可生效（application-local.yml 已被 .gitignore 排除）
# 也可以不建文件，直接用环境变量：DASHSCOPE_API_KEY / MYSQL_USERNAME / MYSQL_PASSWORD
# ============================================================

dashscope:
  api-key: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 如需覆盖数据库连接，取消注释并填写：
# spring:
#   datasource:
#     username: your_db_user
#     password: your_db_password
