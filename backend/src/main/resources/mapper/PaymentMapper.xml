<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heritage.food.dao.PaymentMapper">

    <select id="selectByOrderId" resultType="com.heritage.food.model.Payment">
        SELECT * FROM tb_payment
        WHERE order_id = #{orderId}
    </select>

    <select id="selectByPaymentNo" resultType="com.heritage.food.model.Payment">
        SELECT * FROM tb_payment
        WHERE payment_no = #{paymentNo}
    </select>

</mapper>