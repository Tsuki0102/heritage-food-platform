<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heritage.food.dao.OrderMapper">

    <select id="selectOrderList" resultType="com.heritage.food.model.Order">
        SELECT * FROM tb_order
        WHERE 1=1
        <if test="userId != null">
            AND user_id = #{userId}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="selectOrderByNo" resultType="com.heritage.food.model.Order">
        SELECT * FROM tb_order
        WHERE order_no = #{orderNo}
    </select>

    <select id="selectRecentOrders" resultType="com.heritage.food.model.Order">
        SELECT * FROM tb_order
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

</mapper>
