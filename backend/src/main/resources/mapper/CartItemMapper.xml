<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heritage.food.dao.CartItemMapper">

    <select id="selectByUserId" resultType="com.heritage.food.model.CartItem">
        SELECT * FROM tb_cart_item
        WHERE user_id = #{userId}
    </select>

    <select id="selectByUserIdAndProductId" resultType="com.heritage.food.model.CartItem">
        SELECT * FROM tb_cart_item
        WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM tb_cart_item
        WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM tb_cart_item
        WHERE user_id = #{userId}
    </delete>

</mapper>
